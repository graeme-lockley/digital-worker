# syntax=docker/dockerfile:1
# Builds agent-gateway from the monorepo root (compose build context: project root).

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.5.2 --activate
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @digital-worker/agent-core-protocol run build \
  && pnpm --filter @digital-worker/agent-gateway-protocol run build \
  && pnpm --filter @digital-worker/agent-gateway run build

FROM base AS runtime
RUN apk add --no-cache dcron
COPY --from=build /app /app
COPY infra/dev-workstation/agent-gateway-entrypoint.sh /app/infra/dev-workstation/agent-gateway-entrypoint.sh
COPY infra/dev-workstation/gateway-prune-messages.sh /app/infra/dev-workstation/gateway-prune-messages.sh
COPY infra/dev-workstation/gateway-crontab /etc/crontabs/root
RUN chmod +x /app/infra/dev-workstation/agent-gateway-entrypoint.sh \
  && chmod +x /app/infra/dev-workstation/gateway-prune-messages.sh \
  && chmod 600 /etc/crontabs/root \
  && touch /var/log/gateway-prune.log
WORKDIR /app/apps/agent-gateway
EXPOSE 3002
ENTRYPOINT ["/app/infra/dev-workstation/agent-gateway-entrypoint.sh"]
CMD ["node", "dist/index.js", "--host", "0.0.0.0", "--port", "3002"]
