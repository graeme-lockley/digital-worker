# syntax=docker/dockerfile:1
# Builds agent-wiki from the monorepo root (compose build context: project root).

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.6.0 --activate
WORKDIR /app

FROM base AS build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @digital-worker/agent-wiki-protocol run build \
  && pnpm --filter @digital-worker/agent-wiki run build

FROM base AS runtime
COPY --from=build /app /app
WORKDIR /app/apps/agent-wiki
EXPOSE 3004
CMD ["node", "dist/index.js", "--host", "0.0.0.0", "--port", "3004"]
