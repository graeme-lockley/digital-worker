# Copy to .env in the project root (same folder as package.json). Never commit .env.
# Used by docker-compose (dev-workstation) and local agent-core (DEEPSEEK_API_KEY).

DEEPSEEK_API_KEY=

# Shared libSQL database (register, scheduler, and gateway in dev-workstation Docker)
# Local pnpm dev defaults to file: URLs under ./data/ when unset.
LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=
# SCHEDULER_LEGACY_DATA_DIR=  # optional one-time import path for legacy scheduler.db
# GATEWAY_LEGACY_DATA_DIR=  # optional one-time import path for legacy state.json
# GATEWAY_PRUNE_READ_DAYS=30  # cron prune window for read mailbox messages (Docker gateway container)

# Telegram gateway (agent-gateway service)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
