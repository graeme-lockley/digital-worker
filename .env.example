# Copy to .env in the project root (same folder as package.json). Never commit .env.
# Used by docker-compose (dev-workstation) and local agent-core (DEEPSEEK_API_KEY).

DEEPSEEK_API_KEY=

# Shared libSQL database (register, scheduler, and gateway in dev-workstation Docker)
# Local pnpm dev defaults to file: URLs under ./data/ when unset.
LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=
# SCHEDULER_LEGACY_DATA_DIR=  # optional one-time import path for legacy scheduler.db
# GATEWAY_LEGACY_DATA_DIR=  # optional one-time import path for legacy state.json
# GATEWAY_PRUNE_READ_DAYS=30  # cron prune window for read mailbox messages (Docker gateway container)

# Telegram gateway (agent-gateway service)
# Bot routes are declared in infra/dev-workstation/gateway-telegram-bots.json (or GATEWAY_TELEGRAM_BOTS / GATEWAY_TELEGRAM_BOTS_FILE).
# Each entry uses tokenEnv to name the env var holding that bot's secret token:
TELEGRAM_AIDADIGITALBOT_TOKEN=
TELEGRAM_RIAANDIGITALBOT_TOKEN=
# Legacy single-bot fallback when no GATEWAY_TELEGRAM_BOTS* is set:
# TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional: assign pre-migration mailbox rows/offsets to a configured botId
# GATEWAY_LEGACY_BOT_ID=aidadigitalbot

# Default bot routing id on each agent-core (--telegram-bot-id / TELEGRAM_BOT_ID)
# Must match a botId from gateway-telegram-bots.json
