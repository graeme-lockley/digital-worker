# Copy to .env in the project root for the template Docker stack (pnpm docker:dev).
# Real deployments: use digital-worker-workspace/.env instead.

DEEPSEEK_API_KEY=

# Optional: local pnpm dev without Docker
# WORKSPACE_ROOT=../digital-worker-workspace

# Template stack only — libSQL is in-container; leave unset for Compose defaults.
LIBSQL_URL=

# Template gateway example (not started in template compose; for reference only)
# TELEGRAM_EXAMPLEBOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=
